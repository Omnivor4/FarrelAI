{
  "version": 2,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/farrelai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/farrelai",
      "destination": "/farrelai.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
